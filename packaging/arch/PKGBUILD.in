pkgname=linux-task-manager
pkgver=__VERSION__
pkgrel=1
pkgdesc='Native GTK4 task manager for Linux'
arch=('x86_64')
url='https://github.com/YOUR_GITHUB_USERNAME/linux-task-manager'
license=('MIT')
depends=('gtk4>=4.12')
makedepends=('meson' 'ninja' 'pkgconf')
optdepends=(
  'pciutils: improved GPU model detection'
  'vulkan-tools: improved GPU model detection'
  'mesa-utils: improved GPU model detection'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('__SHA256__')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  meson setup build --prefix=/usr --buildtype=release --wrap-mode=nodownload
  meson compile -C build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
